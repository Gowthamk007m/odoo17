<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <record id="view_hospital_patients_tree" model="ir.ui.view">
      <field name="name">hospital.patients.tree</field>
      <field name="model">hospital.patients</field>
      <field name="arch" type='xml'>
            <tree string="Patients">
            <field name="name"/>
            <field name="age"/>
            <field name="gender"/>
      </tree>
      </field>
   </record>



   <record id="view_hospital_patients_form" model="ir.ui.view">
      <field name="name">hospital.patients.form</field>
      <field name="model">hospital.patients</field>
      <field name="arch" type='xml'>   
            <form string="Patients">
      <sheet>
      <group>
      <group>
            <field name="name"/>
      </group>
      <group>
      
            <field name="age"/>
            <field name="gender"/>
      </group>
         
      </group>
      </sheet>
      </form>
      </field>
   </record>


   <record id="action_hospital_patients" model="ir.actions.act_window">
    <field name="name">Patients</field>
    <field name="res_model">hospital.patients</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
    <p class="o_view_nocontent_smiling_face">Create a patient</p>
    </field>
   </record>
</odoo>