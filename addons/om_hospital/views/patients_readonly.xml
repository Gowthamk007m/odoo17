<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <record id="view_hospital_patients_readonly_tree" model="ir.ui.view">
      <field name="name">hospital.patients.readonly.tree</field>
      <field name="model">hospital.patients</field>
      <field name="arch" type='xml'>
         <tree string="Patients" create="0" delete="0">
            <field name="name"/>
            <field name="age"/>
            <field name="gender"/>
         </tree>
      </field>
   </record>

   <record id="view_hospital_patients_readonly_form" model="ir.ui.view">
      <field name="name">hospital.patients.readonly.form</field>
      <field name="model">hospital.patients</field>
      <field name="arch" type='xml'>   
            <form string="Patients" create="0" delete="0" edit="0">
      <sheet>
      <group>
         <group>
            <field name="name"/>
         </group>
         <group>
      
            <field name="age"/>
            <field name="gender"/>
         </group>
         
      </group>
      </sheet>

      <div class="oe_chatter">
         <field name="message_follower_ids" groups="base.group_user"/>
         <field name="message_ids"/>
      </div>
                     
      </form>
      </field>
   </record>


   <record id="action_hospital_readonly_patients" model="ir.actions.act_window">
    <field name="name">Patients</field>
    <field name="res_model">hospital.patients</field>
    <field name="view_mode">tree,form</field>
         <field name="view_ids" eval="[Command.clear(),
            (0, 0, {'view_mode': 'tree','view_id': ref('view_hospital_patients_readonly_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hospital_patients_readonly_form')})]"/>
    <field name="help" type="html">
    <p class="o_view_nocontent_smiling_face">Create a patient</p>
    </field>
   </record>
</odoo> 